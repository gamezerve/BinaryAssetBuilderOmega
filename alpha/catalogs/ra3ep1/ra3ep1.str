DIALOGEVENT:MY01_DRSHIMADA13
	"No, don't take her!  She's not ready!"
End

DIALOGEVENT:MY01_DRSHIMADA14
	"She isn't ready for the real world!"
End

DIALOGEVENT:MY01_DRSHIMADA15
	"Don't go any further!"
End

DIALOGEVENT:MY01_DRSHIMADA16
	"This is not a drill.  Find and contain the girl."
End

