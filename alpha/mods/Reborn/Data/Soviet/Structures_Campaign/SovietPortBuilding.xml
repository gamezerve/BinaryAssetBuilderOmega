			source="DATA:BaseObjects/BaseSovietStructure.xml" />

	</Includes>
	
	<Defines>
		<Define name="SOVIET_PORT_BUILDING_LOCAL_UNPACK_TIME" value="15s" />
	</Defines>
	
	<GameObject
		id="SovietPortBuilding"
		inheritFrom="BaseSovietStructure"
		SelectPortrait="Button_SovietPortBuilding_big"
		ButtonImage="Button_SovietPortBuilding_small"
		KindOf="-CAN_BUILD_ON_WATER -CAN_BUILD_ON_DEEP_WATER +FS_FACTORY +AUTO_RALLYPOINT +FS_WAR_FACTORY"
		RadarPriority="STRUCTURE"	
		PlacementViewAngle="-45d"	
		ThreatLevel="1.0"		
		ProductionQueueType="MAIN_STRUCTURE"
		BuildPlacementTypeFlag="MAIN_STRUCTURE"
		Side="Soviet"
		EditorName="SovietPortBuilding"
    	EditorSorting="STRUCTURE"
		JustBuiltTime="4.8s"
		HealthBoxHeightOffset="45"
		BuildTime="0.0"
		EnergyProduction="-30"
		CommandSet="SovietPortBuildingCommandSet"
		Browser="REGION Vladivostok_VL STRUCTURE"
		Description="DESC:SOVIETPORTBUILDING"
		TypeDescription="TYPE:SOVIETPORTBUILDING">
		
		<DisplayName
			xai:joinAction="Replace" xmlns:xai="uri:ea.com:eala:asset:instance">NAME:SOVIETPORTBUILDING</DisplayName>
			
		<GameDependency>
			<RequiredObject>SovietNavalYard</RequiredObject>
		</GameDependency>

		<ObjectResourceInfo>
			<BuildCost Account="=$ACCOUNT_ORE" Amount="750"/>
		</ObjectResourceInfo>

		<ArmorSet
			Armor="SovietNavalYardArmor"
			DamageFX="FactionStructureDamageFX" />
		
		<SkirmishAIInformation
			BaseBuildingLocation="FRONT">
      <ConstructionBaseSelectionCriteria
        ExcludedBaseTypes="NO_BUILD_RADIUS CAPTURED"/>
    </SkirmishAIInformation>	
	
		<Draws>
			<ScriptedModelDraw
				id="ModuleTag_Draw"
				OkToChangeModelColor="false"
				AffectedByStealth="false"
				ExtraPublicBone="BoneGarrisonWall01 BoneGarrisonWall02 BoneGarrisonWall03 BoneGarrisonWall04 BONE_CONTACT_POINT_01 BONE_CONTACT_POINT_02 BONE_CONTACT_POINT_03 BONE_CONTACT_POINT_04 BONE_CONTACT_POINT_05 BONE_CONTACT_POINT_06 BONE_CONTACT_POINT_07 BONE_CONTACT_POINT_08 BONE_CONTACT_POINT_09 BONE_CONTACT_POINT_10 BONE_CONTACT_POINT_11 BONE_CONTACT_POINT_12 BONE_CONTACT_POINT_13 BONE_CONTACT_POINT_14 BONE_CONTACT_POINT_15 BONE_CONTACT_POINT_16 BONE_CONTACT_POINT_17 BONE_CONTACT_POINT_18	BONE_CONTACT_POINT_19 BONE_CONTACT_POINT_20 BONEGARRISON01 BONEGARRISON02 BONEGARRISON03 BONEGARRISON04 BONEGARRISON05 BONEGARRISON06 BONEGARRISON07 BONEGARRISON08 BONEGARRISON09 BONEGARRISON10 BONEGARRISON11 BONEGARRISON12">
				<ModelConditionState
					ParseCondStateType="PARSE_DEFAULT">
					<Model
						Name="VL_RussianPortBuilding" />
				</ModelConditionState>
				<ModelConditionState
					ParseCondStateType="PARSE_NORMAL"
					ConditionsYes="RUBBLE">
					<Model
						Name="" />
				</ModelConditionState>

				<AnimationState
					ParseCondStateType="PARSE_DEFAULT">
					<!-- no anim -->
				</AnimationState>
			
			</ScriptedModelDraw>

			<ScriptedModelDraw
				id="ModuleTag_Draw_Selected_Repair_Decal"
				OkToChangeModelColor="true">
				<ModelConditionState
					ParseCondStateType="PARSE_DEFAULT">
					<Model Name="" />
				</ModelConditionState>
				<ModelConditionState
					ParseCondStateType="PARSE_NORMAL"
					ConditionsYes="SELECTED">
					<Model Name="FXInvisBone" /> 
					<ShadowInfo
						Type="ADDITIVE_DECAL"
						SizeX="=$SOVIET_REPAIR_DRONE_HOME_DECAL_SIZE"
						SizeY="=$SOVIET_REPAIR_DRONE_HOME_DECAL_SIZE"
						OverrideLODVisibility="true"
						MaxHeight="200"
						UseHouseColor="true"
						Texture="Decal_Rig_CO"
						LocalPlayerOnly="true"/>
				</ModelConditionState>
			</ScriptedModelDraw>	

		</Draws>
		<Behaviors>
			<Physics
				id="ModuleTag_Physics"/>

			<BuildingDestructionBehavior
				id="ModuleTag_BuildingDestruction">
				<DieMuxData
					DeathTypes="ALL" />
				<Item
					BonePrefix="BONE_CONTACT_POINT_"
					FX="FX_BuildingDebrisExplosion"
					CreationObject="YU_HotelDebris"
					FlingVelocity="100.0"/>
			</BuildingDestructionBehavior>

			<FXListBehavior
				xai:joinAction="Replace" xmlns:xai="uri:ea.com:eala:asset:instance" id="ModuleTag_FXList">
				<DieMuxData
					DeathTypes="ALL" />
				<Event
					Index="onDeath"
					FX="FX_Civ_Explosion_Medium" />
			</FXListBehavior>

			<CreateObjectDie
				id="ModuleTag_CreateObjectDie"
				CreationList="VL_RussianPortBuilding_Die_OCL">
				<DieMuxData
					DeathTypes="ALL" />
			</CreateObjectDie>


			<ProductionUpdate
				id="ModuleTag_ProductionUpdate"
				GiveNoXP="true"
				Type="WATERCRAFT"
				NumDoorAnimations="1"
				DoorOpeningTime="0.66s"
				DoorWaitOpenTime="3.00s"
				DoorCloseTime="0.66s">
				<GiveUpgradeToProduced>
					<UpgradeTranslate
						RequiredUpgrade="Upgrade_ProductionVeterancy_VETERAN"
						ProvidedUpgrade="Upgrade_CreationVeterancy_VETERAN" />
					<UpgradeTranslate
						RequiredUpgrade="Upgrade_ProductionVeterancy_ELITE"
						ProvidedUpgrade="Upgrade_CreationVeterancy_ELITE" />
					<UpgradeTranslate
						RequiredUpgrade="Upgrade_ProductionVeterancy_HEROIC"
						ProvidedUpgrade="Upgrade_CreationVeterancy_HEROIC" />
				</GiveUpgradeToProduced>
			</ProductionUpdate>

			<ProductionUpdate
				id="ModuleTag_UpgradeProductionUpdate"
				Type="UPGRADE"
				MaxQueueEntries="1" />
			<QueueProductionExitUpdate
				id="ModuleTag_QueueProduction"
				ExitDelaySeconds="0.07s">
				<UnitCreatePoint
					x="-50.0"
					y="0.0"
					z="0.0" />
				<NaturalRallyPoint
					x="-50.0"
					y="0.0"
					z="0.0" />
			</QueueProductionExitUpdate>

		<AssignSlavesTargetObjectSpecialPower
				id="ModuleTag_SpecialPowerRepairVehicle"
				SpecialPowerTemplate="SpecialPower_TargetedRepairVehicle" />
			<SpawnBehavior
				id="ModuleTag_SpawnRepairDrones"
				SpawnNumberData="1"
				InitialBurst="1"
				SpawnReplaceDelayData="10s"
				SpawnedRequireSpawner="true"
				KillSpawnsOnCaptured="true"
				SpawnInsideBuilding="true"
				KillSpawnsOnDisabled="true"
                SpawnOnUnpack="true">
				<Die
					DeathTypes="ALL" />
				<SpawnTemplate>SovietRepairDrone</SpawnTemplate>
			</SpawnBehavior>
			
			<StructureUnpackUpdate
				id="ModuleTag_StructureUnpackUpdate"
				UnpackTime="=$SOVIET_PORT_BUILDING_LOCAL_UNPACK_TIME" />
			<xi:include
				href="DATA:Includes/GenericBuildingRepair.xml" />
			<xi:include
				href="DATA:Includes/GenericEngineerContain.xml" />
			<xi:include
				href="DATA:Includes/GenericSovietBuildingDestruction.xml" />
			<xi:include
				href="DATA:Includes/GenericSovietBuildingSuicideNoSpawn.xml" />
			<xi:include
				href="DATA:Includes/InfiltratorContainShip.xml" />

			<StancesBehavior
				id="ModuleTag_Stance"
				StanceTemplate="Generic" />	
		</Behaviors>

		<AI>
			<AIUpdate
				id="ModuleTag_AIUpdate"
				AutoAcquireEnemiesWhenIdle="NO"
				StateMachine="StructureAIStateMachine"/>
		</AI>
		
		<Body>
			<ActiveBody
				id="ModuleTag_Body"
				MaxHealth="2400"
				/>
