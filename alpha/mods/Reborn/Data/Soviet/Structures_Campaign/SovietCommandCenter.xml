	<Includes>
		<Include type="all" source="DATA:GlobalData/GlobalDefines.xml" /> 

		<!-- <Include type="all" source="ART:GE_SovietVIPBunkerSubStructure.W3X" /> -->
			
			
		<!-- Base Object -->
		<Include
			type="instance"
			source="DATA:BaseObjects/BaseSovietStructure.xml" />
	</Includes>
	<GameObject
		id="SovietCommandCenter"
		inheritFrom="BaseSovietStructure"
		SelectPortrait="Portrait_Soviet_VIPBunker"
		ButtonImage="Button_Soviet_VIPBunker"
		Side="Soviet"
		EditorSorting="STRUCTURE"
		BuildTime="0.0"
		CommandSet="SovietCommandCenterCommandSet"
		KindOf="+CONSTRUCTION_YARD +FS_FACTORY"
		RadarPriority="STRUCTURE"
		PlacementViewAngle="315d"
		ProductionQueueType="MAIN_STRUCTURE"
		BuildPlacementTypeFlag="MAIN_STRUCTURE"
		EditorName="SovietCommandCenter"
		EnergyProduction="-125"
		HealthBoxHeightOffset="30"
		Description="DESC:SOVIETCOMMANDCENTER"
		TypeDescription="TYPE:SOVIETCOMMANDCENTER">
		<DisplayName
			xai:joinAction="Replace" xmlns:xai="uri:ea.com:eala:asset:instance">Name:SovietVIPBunker</DisplayName>

		<!-- <GameDependency> -->
			<!-- <RequiredObject>SovietTechStructure</RequiredObject> -->
		<!-- </GameDependency> -->

