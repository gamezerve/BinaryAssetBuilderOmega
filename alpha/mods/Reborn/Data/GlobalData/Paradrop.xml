	<!-- Reborn: grant-only templates expose the existing PLAYER_GRANT_SPECIAL_POWER action; these have only inert registrations, with no UI commands, OCL payloads or positive reload time. -->
	<PlayerTech id="PlayerTech_RebornParadropTransfer2" TechPointsRequired="0">
		<TechDependency>PlayerTech_Allied</TechDependency>
	</PlayerTech>
	<SpecialPowerTemplate id="SpecialPower_RebornParadropGrantTransfer2" TargetType="NONE" ReloadTime="0s" RequiredPlayerTech="PlayerTech_RebornParadropTransfer2"/>
	<PlayerTech id="PlayerTech_RebornParadropTransfer3" TechPointsRequired="0">
