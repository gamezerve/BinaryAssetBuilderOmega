<?xml version="1.0" encoding="us-ascii"?>
<AssetDeclaration xmlns="uri:ea.com:eala:asset" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xai="uri:ea.com:eala:asset:instance">
	<Includes>
		<Include type="instance" source="DATA:BaseObjects/BaseObject.xml" />
		<Include type="instance" source="DATA:BaseObjects/BaseProjectile.xml"/>
		<Include type="instance" source="DATA:System/PlayerSpellBook.xml"/>
    <Include type="instance" source="DATA:Allied\Units_Campaign\CAMP_AlliedBomberAircraft_Infantry_2.xml" />
	</Includes>

<!-- Reborn: purchases in any Allied protocol branch grant shared row 1/3/5 unlocks; XP ranks do not grant these upgrades. -->
<UpgradeTemplate id="Upgrade_RebornParadrop_Row1"
		DisplayName="UpgradeName:RebornParadrop_Row1"
                 Type="PLAYER"/>
<UpgradeTemplate id="Upgrade_RebornParadrop_Row3"
		DisplayName="UpgradeName:RebornParadrop_Row3"
                 Type="PLAYER"/>
<UpgradeTemplate id="Upgrade_RebornParadrop_Row5"
		DisplayName="UpgradeName:RebornParadrop_Row5"
                 Type="PLAYER"/>
<!-- Reborn: preserve both retail Allied upgrade bindings while adding the nine protocol threshold bindings. -->
<PlayerTechUpgradeBinding id="PlayerTechUpgradeBinding_Allied">
	<Binding TechDependency="PlayerTech_Allied_HighTechnology"
	         UpgradeToGrant="Upgrade_AlliedHighTechnology"/>
	<Binding TechDependency="PlayerTech_Allied_AirPower"
	         UpgradeToGrant="Upgrade_AlliedAirPower"/>
	<Binding TechDependency="PlayerTech_Allied_AirPower"
	         UpgradeToGrant="Upgrade_RebornParadrop_Row1"/>
	<Binding TechDependency="PlayerTech_Allied_SatelliteSweep"
	         UpgradeToGrant="Upgrade_RebornParadrop_Row1"/>
	<Binding TechDependency="PlayerTech_Allied_HighTechnology"
	         UpgradeToGrant="Upgrade_RebornParadrop_Row1"/>
	<Binding TechDependency="PlayerTech_Allied_TimeBomb_Rank1"
	         UpgradeToGrant="Upgrade_RebornParadrop_Row3"/>
	<Binding TechDependency="PlayerTech_Allied_ChronoRift_Rank2"
	         UpgradeToGrant="Upgrade_RebornParadrop_Row3"/>
	<Binding TechDependency="PlayerTech_Allied_CryoSatellite_Rank1"
	         UpgradeToGrant="Upgrade_RebornParadrop_Row3"/>
	<Binding TechDependency="PlayerTech_Allied_TimeBomb_Rank3"
	         UpgradeToGrant="Upgrade_RebornParadrop_Row5"/>
	<Binding TechDependency="PlayerTech_ProductionBonus_Allies"
	         UpgradeToGrant="Upgrade_RebornParadrop_Row5"/>
	<Binding TechDependency="PlayerTech_Allied_CryoSatellite_Rank3"
	         UpgradeToGrant="Upgrade_RebornParadrop_Row5"/>
</PlayerTechUpgradeBinding>

	<GameObject
		id="PlayerSpellBook"
		inheritFrom="PlayerSpellBook">
		<Behaviors>
			<!-- Reborn: inert registrations let native script grant lookup resolve the two hidden technology markers; they never spawn units. -->
			<SpecialPower id="ModuleTag_RebornParadropGrantTransfer2" SpecialPowerTemplate="SpecialPower_RebornParadropGrantTransfer2" AvailableAtStart="true"/>
			<SpecialPower id="ModuleTag_RebornParadropGrantTransfer3" SpecialPowerTemplate="SpecialPower_RebornParadropGrantTransfer3" AvailableAtStart="true"/>

			<!-- Reborn: one shared row transition grants one PlayerTech marker, triggering native percentage transfer only once. -->
			<LUAEventList id="ModuleTag_RebornParadropCooldownEvents" EventListName="RebornParadropCooldownFunctions"/>
			<ModelConditionUpgrade id="ModuleTag_RebornParadropCooldownRow3" AddConditionFlags="USER_9" Permanent="true">
				<TriggeredBy>Upgrade_RebornParadrop_Row3</TriggeredBy>
			</ModelConditionUpgrade>
			<ModelConditionUpgrade id="ModuleTag_RebornParadropCooldownRow5" AddConditionFlags="USER_10" Permanent="true">
				<TriggeredBy>Upgrade_RebornParadrop_Row5</TriggeredBy>
			</ModelConditionUpgrade>

			<!-- Reborn: shared row upgrades select one canonical Paradrop level without protocol-specific power copies. -->
			<CommandSetUpgrade id="ModuleTag_SpellbookParadropMenuRank1" CommandSet="PlayerSpellBookCommandSetRank1">
				<TriggeredBy>Upgrade_RebornParadrop_Row1</TriggeredBy>
				<ConflictsWith>Upgrade_RebornParadrop_Row3</ConflictsWith>
				<ConflictsWith>Upgrade_RebornParadrop_Row5</ConflictsWith>
			</CommandSetUpgrade>
			<CommandSetUpgrade id="ModuleTag_SpellbookParadropMenuRank2" CommandSet="PlayerSpellBookCommandSetRank2">
				<TriggeredBy>Upgrade_RebornParadrop_Row3</TriggeredBy>
				<ConflictsWith>Upgrade_RebornParadrop_Row5</ConflictsWith>
			</CommandSetUpgrade>
			<CommandSetUpgrade id="ModuleTag_SpellbookParadropMenuRank3" CommandSet="PlayerSpellBookCommandSetRank3">
				<TriggeredBy>Upgrade_RebornParadrop_Row5</TriggeredBy>
			</CommandSetUpgrade>

      <!-- Reborn: each canonical level uses SHARED_SYNC across any spellbook and tower handlers with that same template ID. -->
      <!-- Paradrop -->
      <PlayerPowerManager
				id="ModuleTag_PlayerPowerManager_ParadropLvl1"
				SpecialPowerTemplate="SpecialPowerParadropLvl1"
			/>
      <OCLSpecialPower
				id="ModuleTag_ParadropLvl1"
				SpecialPowerTemplate="SpecialPowerParadropLvl1"
				UpdateModuleStartsAttack="false"
				AvailableAtStart="true"
				OCL="OCL_ParaDropLvl1"
				DestinationOCL="OCL_PrecisionStrikeBeacon"
				CreateLocation="CREATE_AT_OFFSET_FROM_TARGET_ALONG_SECONDARY_OBJECT_VECTOR_AND_MOVE_TO_TARGET"
				CreateLocationOffset="1000.0">
        <NearestSecondaryObjectFilter
					Relationship="SAME_PLAYER">
          <IncludeThing>AlliedConstructionYard</IncludeThing>
        </NearestSecondaryObjectFilter>
      </OCLSpecialPower>

      <PlayerPowerManager
        id="ModuleTag_PlayerPowerManager_ParadropLvl2"
        SpecialPowerTemplate="SpecialPowerParadropLvl2"
			/>
      <OCLSpecialPower
				id="ModuleTag_ParadropLvl2"
				SpecialPowerTemplate="SpecialPowerParadropLvl2"
				UpdateModuleStartsAttack="false"
				AvailableAtStart="true"
				OCL="OCL_ParaDropLvl2"
        DestinationOCL="OCL_PrecisionStrikeBeacon"
				CreateLocation="CREATE_AT_OFFSET_FROM_TARGET_ALONG_SECONDARY_OBJECT_VECTOR_AND_MOVE_TO_TARGET"
				LeechRechargePercentPlayerTechTrigger="PlayerTech_RebornParadropTransfer2"
				LeechRechargePercentFromSpecialPower="SpecialPowerParadropLvl1"
			  CreateLocationOffset="1000.0">
        <NearestSecondaryObjectFilter
					Relationship="SAME_PLAYER">
          <IncludeThing>AlliedConstructionYard</IncludeThing>
        </NearestSecondaryObjectFilter>
      </OCLSpecialPower>

      <PlayerPowerManager
        id="ModuleTag_PlayerPowerManager_ParadropLvl3"
        SpecialPowerTemplate="SpecialPowerParadropLvl3"
			/>
      <OCLSpecialPower
				id="ModuleTag_ParadropLvl3"
				SpecialPowerTemplate="SpecialPowerParadropLvl3"
				UpdateModuleStartsAttack="false"
				AvailableAtStart="true"
				OCL="OCL_ParaDropLvl3"
        DestinationOCL="OCL_PrecisionStrikeBeacon"
				CreateLocation="CREATE_AT_OFFSET_FROM_TARGET_ALONG_SECONDARY_OBJECT_VECTOR_AND_MOVE_TO_TARGET"
				LeechRechargePercentPlayerTechTrigger="PlayerTech_RebornParadropTransfer3"
				LeechRechargePercentFromSpecialPower="SpecialPowerParadropLvl2"
			  CreateLocationOffset="1000.0">
        <NearestSecondaryObjectFilter
					Relationship="SAME_PLAYER">
          <IncludeThing>AlliedConstructionYard</IncludeThing>
        </NearestSecondaryObjectFilter>
      </OCLSpecialPower>

		</Behaviors>
	</GameObject>

  <LogicCommand
    Options="NEED_TARGET_POS"
    Type="SPECIAL_POWER"
    id="Command_ParadropLvl1">
    <SpecialPower>SpecialPowerParadropLvl1</SpecialPower>
    <AISpecialPowerInfo
       Heuristic="PLAYER_AOE_BUFF"
       Manager="SKIRMISH_AI"
       TargetObjectInclude="CAN_ATTACK"
       MinTargetsHit="1"
       MinEnemiesNearby="5">
    </AISpecialPowerInfo>
  </LogicCommand>
  <LogicCommand
		Options="NEED_TARGET_POS"
		Type="SPECIAL_POWER"
		id="Command_ParadropLvl2">
    <SpecialPower>SpecialPowerParadropLvl2</SpecialPower>
    <AISpecialPowerInfo
       Heuristic="PLAYER_AOE_BUFF"
       Manager="SKIRMISH_AI"
       TargetObjectInclude="CAN_ATTACK"
       MinTargetsHit="1"
       MinEnemiesNearby="5">
    </AISpecialPowerInfo>
  </LogicCommand>
  <LogicCommand
		Options="NEED_TARGET_POS"
		Type="SPECIAL_POWER"
		id="Command_ParadropLvl3">
    <SpecialPower>SpecialPowerParadropLvl3</SpecialPower>
    <AISpecialPowerInfo
       Heuristic="PLAYER_AOE_BUFF"
       Manager="SKIRMISH_AI"
       TargetObjectInclude="CAN_ATTACK"
       MinTargetsHit="1"
       MinEnemiesNearby="5">
    </AISpecialPowerInfo>
  </LogicCommand>

	<!-- ParaDrop Power -->
	<!-- Reborn: synchronize this template's timer across the player's spellbook and Control Tower instances. -->
	<SpecialPowerTemplate
		id="SpecialPowerParadropLvl1"
		ReloadTime="300s"
		TargetType="LOCATION"
		EvaEventToPlayWhenSelectingTarget="SelectSpecialPowerTargetArea"
		RadiusCursorRadius="100"
		Flags="IS_PLAYER_POWER PATHABLE_ONLY NOT_CLIFF_CELL NO_FORBIDDEN_OBJECTS SHARED_SYNC"
		WaypointModeTerminal="false"
		RequiredPlayerTech="PlayerTech_Allied">
		<ForbiddenObjectFilter
			Rule="ANY"
			Include="STRUCTURE CRUSHABLE_OBSTACLE AIRCRAFT"
			Exclude="BRIDGE_ENDCAP BRIDGE_SEGMENT">
			<ExcludeThing>NanoSwarmHiveEffect</ExcludeThing>
		</ForbiddenObjectFilter>
		<GameDependency
			id="Allied_Paradrop_Rank1_GameDependency">
			<RequiredObject>AlliedAirportControlTower</RequiredObject>
			<ForbiddenUpgrade>Upgrade_RebornParadrop_Row3</ForbiddenUpgrade>
			<ForbiddenUpgrade>Upgrade_RebornParadrop_Row5</ForbiddenUpgrade>
			<NeededUpgrade>Upgrade_RebornParadrop_Row1</NeededUpgrade>
		</GameDependency>
	</SpecialPowerTemplate>

	<!-- Reborn: synchronize this template's timer across the player's spellbook and Control Tower instances. -->
	<SpecialPowerTemplate
		id="SpecialPowerParadropLvl2"
		ReloadTime="330s"
		TargetType="LOCATION"
		EvaEventToPlayWhenSelectingTarget="SelectSpecialPowerTargetArea"
		RadiusCursorRadius="120"
		Flags="IS_PLAYER_POWER PATHABLE_ONLY NOT_CLIFF_CELL NO_FORBIDDEN_OBJECTS SHARED_SYNC"
		WaypointModeTerminal="false"
