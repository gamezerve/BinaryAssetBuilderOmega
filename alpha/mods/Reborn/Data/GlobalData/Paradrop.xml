				Options="IGNORE_ALL_OBJECTS DONT_SET_PRODUCER ISSUE_MOVE_AFTER_CREATION FIRE_SPECIAL_POWER MOVE_TARGET_USES_OFFSET ORIENT_TOWARD_MOVE_DESTINATION CREATE_AT_TARGET"
