        id="SOV_RebornSuperReactor_Sparks"
        Volume="20"
        VolumeShift="-5"
        MinRange="100"
        MaxRange="400"
        ShrunkenPitchModifier="2"
        ShrunkenVolumeModifier="85"
        ReverbEffectLevel="100"
        Limit="3"
        Priority="LOWEST"
        Type="WORLD SHROUDED EVERYONE"
        SubmixSlider="AMBIENT">

        <PitchShift Low="-10" High="0" />

        <Sound>WBRepair_droneSparka</Sound>
        <Sound>WBRepair_droneSparkb</Sound>
        <Sound>WBRepair_droneSparkc</Sound>
    </AudioEvent>
	
