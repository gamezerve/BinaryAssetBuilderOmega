		<Include
			type="instance"
			source="DATA:BaseObjects/BaseStructure.xml" />
		
	</Includes>
	<GameObject
		id="JapanCommandCenter"
		inheritFrom="BaseStructure"
		EditorName="JapanCommandCenter"
		Side="Japan"
    	EditorSorting="STRUCTURE"
		BuildTime="0.0"
		CommandSet="JapanCommandCenterCommandSet"
		KindOf="+ACTIVATE_AFTER_UNPACK +CONSTRUCTION_YARD +FS_FACTORY"
		RadarPriority="STRUCTURE"
		Browser="REGION Tokyo_Harbor_TH STRUCTURE"
		PlacementViewAngle="315d"
		EnergyProduction="-125"
		HealthBoxHeightOffset="30"
		ProductionQueueType="MAIN_STRUCTURE"
		BuildPlacementTypeFlag="MAIN_STRUCTURE"
		SelectPortrait="Portrait_JapanVIPBunker"
		ButtonImage="Button_JapanVIPBunker"
		TypeDescription="TYPE:JAPANCOMMANDCENTER"
		Description="DESC:JAPANCOMMANDCENTER">
