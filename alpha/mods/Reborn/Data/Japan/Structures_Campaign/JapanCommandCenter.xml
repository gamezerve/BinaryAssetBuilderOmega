	<ObjectCreationList
		id="TH_JapanVIPBunkerSubStructure_Die_OCL">
		<CreateObject
			Options="IGNORE_ALL_OBJECTS"
			Disposition="LIKE_EXISTING RANDOM_FORCE"
			Count="1"
			MinForceMagnitude="1.0"
			MaxForceMagnitude="2.0"
			MinForcePitch="90d"
			MaxForcePitch="75d">
			<CreateObject>TH_JapanVIPBunkerSubStructure_Collapse</CreateObject>
		</CreateObject>
