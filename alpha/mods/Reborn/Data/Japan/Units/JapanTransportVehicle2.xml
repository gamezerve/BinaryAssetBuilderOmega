					DeathTypes="ALL" />
			</DestroyDie>
			<FXListBehavior
				id="ModuleTag_FXList">
				<DieMuxData
					DeathTypes="ALL" />
				<Event
					Index="onDeath"
					FX="FX_AlliedChieftanDie" />
			</FXListBehavior>

			<FireWeaponWhenDead
				id="ModuleTag_JapanLightTransportVehicleDeathWeapon"
				DeathWeapon="JapanLightTransportVehicleDeathWeapon"
				InitiallyActive="true">
