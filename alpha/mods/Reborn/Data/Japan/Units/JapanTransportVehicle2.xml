					AnimationMode="LOOP" />
        <ParticleSysBone
          BoneName="None"
          FXParticleSystemTemplate="HelicopterMovingWaterWake"
          FollowBone="false" />
        <ParticleSysBone
          BoneName="None"
          FXParticleSystemTemplate="HoverTransportWaterMist"
          FollowBone="false" />        
      </AnimationState>
			</TruckDraw>
