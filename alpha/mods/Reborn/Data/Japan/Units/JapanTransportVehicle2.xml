          <ParticleSysBone
						BoneName="JapanTransportVehicle202"
						FXParticleSystemTemplate="JapanVehicleDamagedSparks"
						FollowBone="true" />
          <ParticleSysBone
						BoneName="JapanTransportVehicle202"
						FXParticleSystemTemplate="JapanVehicleDamagedFire"
						FollowBone="true" />
      </ModelConditionState> 
      
      <AnimationState
					ParseCondStateType="PARSE_DEFAULT">
