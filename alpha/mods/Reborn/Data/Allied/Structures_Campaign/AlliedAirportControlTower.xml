		<!-- Base Object -->
		<Include type="instance" source="DATA:BaseObjects/BaseStructure.xml" />		
	</Includes>
	<GameObject
		id="AlliedAirportControlTower"
		SelectPortrait="Portrait_LAXControlTower"
		ButtonImage="Button_LAXControlTower"
		inheritFrom="BaseStructure"
		Side="Allies"
		EditorName="AlliedAirportControlTower"	
		KindOf="-CAN_BUILD_ON_WATER -CAN_BUILD_ON_DEEP_WATER +RADAR_SCRAMBLER +AUTO_ACQUIRABLE_BY_AI +FS_FACTORY +FS_TECHNOLOGY +ACTIVATE_AFTER_UNPACK" 
		RadarPriority="STRUCTURE"
    	EditorSorting="STRUCTURE"
		PlacementViewAngle="45d"
		EnergyProduction="-50"
		ProductionQueueType="OTHER_STRUCTURE"
		BuildPlacementTypeFlag="OTHER_STRUCTURE"
		BuildTime="4.5"
		CommandSet="AlliedAirportControlTowerCommandSet"
		TypeDescription="TYPE:AlliedAirportControlTower"
		Description="DESC:AlliedAirportControlTower"
		HealthBoxHeightOffset="20"
		MaxSimultaneousOfType="1">
		<DisplayName
			xai:joinAction="Replace" xmlns:xai="uri:ea.com:eala:asset:instance">NAME:LAControlTower</DisplayName>
		<GameDependency>
			<RequiredObject>AlliedAirfield</RequiredObject>
		</GameDependency>
		<GameDependency>
			<RequiredObject>AlliedRadioTower</RequiredObject>
		</GameDependency>
		<ObjectResourceInfo>
			<BuildCost Account="=$ACCOUNT_ORE" Amount="3000"/>
		</ObjectResourceInfo>
		<ArmorSet
			Armor="BaseFactionStructureArmor"
			DamageFX="FactionStructureDamageFX" />
		<SkirmishAIInformation
			BaseBuildingLocation="CENTER">
      <ConstructionBaseSelectionCriteria
        ExcludedBaseTypes="NO_BUILD_RADIUS CAPTURED"
        PreferredBaseTypes="MAIN_BASE"
        SortOrder="PREFER_OLDEST" />
    </SkirmishAIInformation>

		<Draws>
			<ScriptedModelDraw
				id="ModuleTag_Draw"
				OkToChangeModelColor="true"
				ExtraPublicBone="BONE_CONTACT_POINT_01 BONE_CONTACT_POINT_02 BONE_CONTACT_POINT_03 BONE_CONTACT_POINT_04 BONE_CONTACT_POINT_05 BONE_CONTACT_POINT_06 BONE_CONTACT_POINT_07 BONE_CONTACT_POINT_08 BONE_CONTACT_POINT_09 BONE_CONTACT_POINT_10 BONE_CONTACT_POINT_11 BONE_CONTACT_POINT_12 BONE_CONTACT_POINT_13 BONE_CONTACT_POINT_14 BONE_CONTACT_POINT_15 BONE_CONTACT_POINT_16 BONE_CONTACT_POINT_17 BONE_CONTACT_POINT_18 BONE_CONTACT_POINT_19 BONE_CONTACT_POINT_20">
				<ModelConditionState
					ParseCondStateType="PARSE_DEFAULT">
					<Model
						Name="SA_LAXControlTower" />
				</ModelConditionState>
			</ScriptedModelDraw>
		</Draws>

		<Behaviors>
			<!-- Reborn: the physical tower supplies creation/row events too; persistent PlayerTech markers deduplicate callbacks from both owners. -->
			<LUAEventList id="ModuleTag_RebornParadropTowerCooldownEvents" EventListName="RebornParadropCooldownFunctions"/>
			<ModelConditionUpgrade id="ModuleTag_RebornParadropTowerCooldownRow3" AddConditionFlags="USER_9" Permanent="true">
				<TriggeredBy>Upgrade_RebornParadrop_Row3</TriggeredBy>
			</ModelConditionUpgrade>
			<ModelConditionUpgrade id="ModuleTag_RebornParadropTowerCooldownRow5" AddConditionFlags="USER_10" Permanent="true">
				<TriggeredBy>Upgrade_RebornParadrop_Row5</TriggeredBy>
			</ModelConditionUpgrade>

			<!-- Reborn: shared row upgrades select one canonical Paradrop level without protocol-specific power copies. -->
			<CommandSetUpgrade id="ModuleTag_TowerParadropMenuRank1" CommandSet="AlliedAirportControlTowerCommandSetRank1">
				<TriggeredBy>Upgrade_RebornParadrop_Row1</TriggeredBy>
				<ConflictsWith>Upgrade_RebornParadrop_Row3</ConflictsWith>
				<ConflictsWith>Upgrade_RebornParadrop_Row5</ConflictsWith>
			</CommandSetUpgrade>
			<CommandSetUpgrade id="ModuleTag_TowerParadropMenuRank2" CommandSet="AlliedAirportControlTowerCommandSetRank2">
				<TriggeredBy>Upgrade_RebornParadrop_Row3</TriggeredBy>
				<ConflictsWith>Upgrade_RebornParadrop_Row5</ConflictsWith>
			</CommandSetUpgrade>
			<CommandSetUpgrade id="ModuleTag_TowerParadropMenuRank3" CommandSet="AlliedAirportControlTowerCommandSetRank3">
				<TriggeredBy>Upgrade_RebornParadrop_Row5</TriggeredBy>
			</CommandSetUpgrade>

			<!-- Reborn: tower-owned Paradrop handlers serve building commands; spellbook handlers are configured separately. -->
			<OCLSpecialPower
				id="ModuleTag_ParadropLvl1"
				SpecialPowerTemplate="SpecialPowerParadropLvl1"
				UpdateModuleStartsAttack="false"
				AvailableAtStart="true"
				OCL="OCL_ParaDropLvl1"
				DestinationOCL="OCL_PrecisionStrikeBeacon"
				CreateLocation="CREATE_AT_OFFSET_FROM_TARGET_ALONG_SECONDARY_OBJECT_VECTOR_AND_MOVE_TO_TARGET"
				CreateLocationOffset="1000.0">
        <NearestSecondaryObjectFilter
					Relationship="SAME_PLAYER">
          <IncludeThing>AlliedConstructionYard</IncludeThing>
        </NearestSecondaryObjectFilter>
      </OCLSpecialPower>
			<OCLSpecialPower
				id="ModuleTag_ParadropLvl2"
				SpecialPowerTemplate="SpecialPowerParadropLvl2"
				UpdateModuleStartsAttack="false"
				AvailableAtStart="true"
				OCL="OCL_ParaDropLvl2"
        DestinationOCL="OCL_PrecisionStrikeBeacon"
				CreateLocation="CREATE_AT_OFFSET_FROM_TARGET_ALONG_SECONDARY_OBJECT_VECTOR_AND_MOVE_TO_TARGET"
				LeechRechargePercentPlayerTechTrigger="PlayerTech_RebornParadropTransfer2"
				LeechRechargePercentFromSpecialPower="SpecialPowerParadropLvl1"
			  CreateLocationOffset="1000.0">
        <NearestSecondaryObjectFilter
					Relationship="SAME_PLAYER">
          <IncludeThing>AlliedConstructionYard</IncludeThing>
        </NearestSecondaryObjectFilter>
      </OCLSpecialPower>
			<OCLSpecialPower
				id="ModuleTag_ParadropLvl3"
				SpecialPowerTemplate="SpecialPowerParadropLvl3"
				UpdateModuleStartsAttack="false"
				AvailableAtStart="true"
				OCL="OCL_ParaDropLvl3"
        DestinationOCL="OCL_PrecisionStrikeBeacon"
				CreateLocation="CREATE_AT_OFFSET_FROM_TARGET_ALONG_SECONDARY_OBJECT_VECTOR_AND_MOVE_TO_TARGET"
				LeechRechargePercentPlayerTechTrigger="PlayerTech_RebornParadropTransfer3"
				LeechRechargePercentFromSpecialPower="SpecialPowerParadropLvl2"
			  CreateLocationOffset="1000.0">
        <NearestSecondaryObjectFilter
					Relationship="SAME_PLAYER">
          <IncludeThing>AlliedConstructionYard</IncludeThing>
        </NearestSecondaryObjectFilter>
      </OCLSpecialPower>

			<Physics
				id="ModuleTag_Physics"/>

			<BuildingDestructionBehavior
				id="ModuleTag_BuildingDestruction">
				<DieMuxData
					DeathTypes="ALL" />
				<Item
					BonePrefix="BONE_CONTACT_POINT_"
					FX="FX_BuildingDebrisExplosion"
					CreationObject="YU_HotelDebris"
					FlingVelocity="100.0"/>
			</BuildingDestructionBehavior>

			<FXListBehavior
				xai:joinAction="Replace" xmlns:xai="uri:ea.com:eala:asset:instance" id="ModuleTag_FXList">
				<DieMuxData
					DeathTypes="ALL" />
				<Event
					Index="onDeath"
					FX="FX_Civ_Explosion_Tiny" />
			</FXListBehavior>

			<CreateObjectDie
				id="ModuleTag_CreateObjectDie"
				CreationList="SA_LAXControlTower_Die_OCL">
				<DieMuxData
					DeathTypes="ALL" />
			</CreateObjectDie>	

			<!-- civ buildings should have a CreateObjectDie to make a collapse version. -->
			<DestroyDie
				id="ModuleTag_DestroyDie">
				<DieMuxData
					DeathTypes="ALL" />
			</DestroyDie>	

			<StructureUnpackUpdate
				id="ModuleTag_StructureUnpackUpdate"
				UnpackTime="5s" />
			<xi:include
				href="DATA:Includes/GenericBuildingRepair.xml" />
			<xi:include
				href="DATA:Includes/GenericEngineerContain.xml" />
			<xi:include
				href="DATA:Includes/GenericAlliedBuildingDestruction.xml" />
			<xi:include
				href="DATA:Includes/GenericAlliedBuildingSuicide.xml" />
			<xi:include
				href="DATA:Includes/InfiltratorContainParalyze.xml" />	

		</Behaviors>

		<AI>
			<AIUpdate
				id="ModuleTag_AIUpdate"
				AutoAcquireEnemiesWhenIdle="NO"
				StateMachine="StructureAIStateMachine">
			</AIUpdate>
		</AI>

		<Body>
			<ActiveBody
				id="ModuleTag_Body"
				MaxHealth="3000"
				/>
		</Body>
		<Geometry
			IsSmall="false">
<Shape 
     Type= "BOX"
     MajorRadius = "22.2735"
     MinorRadius = "27.9198"
     Height = "148.281"
     ContactPointGeneration = "STRUCTURE" >
    <Offset
        x = "-0.399031"
        y = "-0.546547"
        z = "0.0" />
</Shape>
		</Geometry>
		<AudioArraySound>
			<AudioEntry Sound="HumanFaction_MediumBuilding_LightDamageMS" AudioType="soundOnDamaged" />
			<AudioEntry Sound="HumanFaction_MediumBuilding_HeavyDamageMS" AudioType="soundOnReallyDamaged" />
		</AudioArraySound>

		<VisionInfo
			VisionRange="150"
			ShroudClearingRange="500" />

	</GameObject>

	<ObjectCreationList
		id="SA_LAXControlTower_Die_OCL">
		<CreateObject
			Options="IGNORE_ALL_OBJECTS"
			Disposition="LIKE_EXISTING RANDOM_FORCE"
			Count="1"
			MinForceMagnitude="1.0"
			MaxForceMagnitude="2.0"
			MinForcePitch="90d"
			MaxForcePitch="75d">
			<CreateObject>SA_LAXControlTower_Collapse</CreateObject>
		</CreateObject>
	</ObjectCreationList>

