					DeathTypes="ALL" />
				<Event
					Index="onDeath"
					FX="FX_Civ_Explosion_Large" />
				<Event
					Index="onDeath"
					FX="FX_Civ_Explosion_Tiny" />
				<Event
					Index="onDeath"
