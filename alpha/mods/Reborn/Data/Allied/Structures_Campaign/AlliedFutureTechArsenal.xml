	<GameObject
		id="AlliedFutureTechArsenal"
		inheritFrom="BaseStructure"
		SelectPortrait="Portrait_Special_NR_Futuretech_WarFactory"
		ButtonImage="Button_Special_NR_Futuretech_WarFactory"
		Side="Allies"
		EditorSorting="STRUCTURE"
		BuildTime="20"
		CommandSet="AlliedWarFactoryCommandSet"
		KindOf="+FS_TECHNOLOGY -CAN_BUILD_ON_WATER -CAN_BUILD_ON_DEEP_WATER +FS_FACTORY +AUTO_RALLYPOINT +FS_WAR_FACTORY"
		RadarPriority="STRUCTURE"
		PlacementViewAngle="225d"
		ProductionQueueType="MAIN_STRUCTURE"
		BuildPlacementTypeFlag="MAIN_STRUCTURE"
		EditorName="AlliedFutureTechArsenal"
		EnergyProduction="-50"
		HealthBoxHeightOffset="30"
		Description="DESC:AlliedFutureTechArsenal"
		TypeDescription="TYPE:AlliedFutureTechArsenal">
		<DisplayName
			xai:joinAction="Replace" xmlns:xai="uri:ea.com:eala:asset:instance">Name:AlliedFutureTechArsenal</DisplayName>
		<GameDependency>
			<RequiredObject>AlliedFutureTechCoolingTower</RequiredObject>
		</GameDependency>

		<ObjectResourceInfo>
			<BuildCost Account="=$ACCOUNT_ORE" Amount="2500"/>
		</ObjectResourceInfo>
		<ArmorSet
