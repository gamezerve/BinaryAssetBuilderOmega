<?xml version="1.0" encoding="utf-8"?>
<AssetDeclaration xmlns="uri:ea.com:eala:asset" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xi="http://www.w3.org/2001/XInclude">
	<Tags></Tags>
	<Includes>
		<Include type="all" source="DATA:GlobalData/GlobalDefines.xml" /> 

		<Include type="all"	source="ART:NY_FortWatchtower.w3x" />
		<Include type="all"	source="ART:NY_FortWatchtower_GAR.w3x" />
		<Include type="instance" source="DATA:Allied/Props/AlliedBarracks_Debris.xml" />
		<Include type="instance" source="DATA:Civilian/New_York_NY/Props/NY_FortWatchtower_Collapse.xml" />
			
			
		<!-- Base Object -->
		<Include
			type="instance"
			source="DATA:BaseObjects/BaseStructure.xml" />
	</Includes>
	<GameObject
		id="AlliedFBWatchtower"
		inheritFrom="BaseStructure"
		SelectPortrait="Portrait_AlliedFBWatchtower"
		ButtonImage="Button_AlliedFBWatchtower"
		Side="Allies"
		EditorSorting="STRUCTURE"
		BuildTime="10"
		CommandSet="AlliedFBWatchtowerCommandSet"
		KindOf="-CAN_BUILD_ON_WATER -CAN_BUILD_ON_DEEP_WATER"
		RadarPriority="STRUCTURE"
		PlacementViewAngle="45d"
		ProductionQueueType="OTHER_STRUCTURE"
		BuildPlacementTypeFlag="OTHER_STRUCTURE"
		EditorName="AlliedFBWatchtower"
		EnergyProduction="0"
		HealthBoxHeightOffset="30"
		Description="DESC:AlliedFBWatchtower"
		TypeDescription="TYPE:AlliedFBWatchtower">
		<DisplayName
			xai:joinAction="Replace" xmlns:xai="uri:ea.com:eala:asset:instance">Name:AlliedFBWatchtower</DisplayName>


		<ObjectResourceInfo>
			<BuildCost Account="=$ACCOUNT_ORE" Amount="1000"/>
		</ObjectResourceInfo>
		<ArmorSet
			Armor="BaseFactionStructureArmor"
			DamageFX="FactionStructureDamageFX" />
		<SkirmishAIInformation
			BaseBuildingLocation="FRONT">
		<ConstructionBaseSelectionCriteria
			ExcludedBaseTypes="NO_BUILD_RADIUS CAPTURED"
			PreferredBaseTypes="MAIN_BASE"
			SortOrder="PREFER_OLDEST" />
		</SkirmishAIInformation>

		<Draws>
			<ScriptedModelDraw
				id="ModuleTag_Draw"
				OkToChangeModelColor="false"
				AffectedByStealth="false"
				ExtraPublicBone="BoneGarrisonWall01 BoneGarrisonWall02 BoneGarrisonWall03 BoneGarrisonWall04 BONE_CONTACT_POINT_01 BONE_CONTACT_POINT_02 BONE_CONTACT_POINT_03 BONE_CONTACT_POINT_04 BONE_CONTACT_POINT_05 BONE_CONTACT_POINT_06 BONE_CONTACT_POINT_07 BONE_CONTACT_POINT_08 BONE_CONTACT_POINT_09 BONE_CONTACT_POINT_10 BONE_CONTACT_POINT_11 BONE_CONTACT_POINT_12 BONE_CONTACT_POINT_13 BONE_CONTACT_POINT_14 BONE_CONTACT_POINT_15 BONE_CONTACT_POINT_16 BONE_CONTACT_POINT_17 BONE_CONTACT_POINT_18	BONE_CONTACT_POINT_19 BONE_CONTACT_POINT_20 BONEGARRISON01 BONEGARRISON02 BONEGARRISON03 BONEGARRISON04 BONEGARRISON05 BONEGARRISON06 BONEGARRISON07 BONEGARRISON08 BONEGARRISON09 BONEGARRISON10 BONEGARRISON11 BONEGARRISON12">
				<ModelConditionState
					ParseCondStateType="PARSE_DEFAULT">
					<Model
						Name="NY_FortWatchtower" />
				</ModelConditionState>
				<ModelConditionState
					ParseCondStateType="PARSE_NORMAL"
					ConditionsYes="RUBBLE">
					<Model
						Name="" />
				</ModelConditionState>

				<AnimationState
					ParseCondStateType="PARSE_DEFAULT">
					<!-- no anim -->
				</AnimationState>
			
			</ScriptedModelDraw>

			<xi:include
				href="DATA:Includes/GarrisonFlagArmorSmallDraw.xml"
				xpointer="xmlns(n=uri:ea.com:eala:asset) xpointer(/n:CommonArmorDraws/child::*)" />



		</Draws>





		<Behaviors>
	  <SquishCollide
				id ="DefaultSquishCollide"
				AllowAllyCrush="true"/>
			<Physics id="ModuleTag_Physics"/>
			<BuildingDestructionBehavior
				id="ModuleTag_BuildingDestruction">
				<DieMuxData DeathTypes="ALL" />
				<Item
					BonePrefix="BONE_CONTACT_POINT_"
					FX="FX_BuildingDebrisExplosion"
					CreationObject="AlliedBarracks_Debris"
					FlingVelocity="100.0"/>
			</BuildingDestructionBehavior>
			<FXListBehavior
				xai:joinAction="Replace" xmlns:xai="uri:ea.com:eala:asset:instance" id="ModuleTag_FXList">
				<DieMuxData DeathTypes="ALL" />
				<Event
					Index="onDeath"
					FX="FX_Civ_Explosion_Medium" />
			</FXListBehavior>
			<CreateObjectDie
				id="ModuleTag_CreateObjectDie"
				CreationList="NY_FortWatchtower_Die_OCL">
				<DieMuxData DeathTypes="ALL" />
			</CreateObjectDie>	
			<!-- civ buildings should have a CreateObjectDie to make a collapse version. -->
			<DestroyDie
				id="ModuleTag_DestroyDie">
				<DieMuxData
					DeathTypes="ALL" />
			</DestroyDie>
			
			<StructureUnpackUpdate
				id="ModuleTag_StructureUnpackUpdate"
				UnpackTime="1.5s" />
			<xi:include
				href="DATA:Includes/GenericBuildingRepair.xml" />

			






		</Behaviors>
		<Body>
			<ActiveBody
				id="ModuleTag_Body"
				MaxHealth="1500"
				/>
		</Body>

		
		
		<Geometry
			IsSmall="false">
      <Shape
           Type= "BOX"
           MajorRadius = "18.6476"
           MinorRadius = "16.8074"
           Height = "90.0"
           ContactPointGeneration = "STRUCTURE" >
        <Offset
            x = "0.0"
            y = "0.0"
            z = "0.0" />
      </Shape>	

		</Geometry>
		
		

		<AudioArraySound>
			<AudioEntry Sound="HumanFaction_MediumBuilding_LightDamageMS" AudioType="soundOnDamaged" />
			<AudioEntry Sound="HumanFaction_MediumBuilding_HeavyDamageMS" AudioType="soundOnReallyDamaged" />
		</AudioArraySound> 

		<VisionInfo
			VisionRange="350"
			ShroudClearingRange="650" />
	</GameObject>
	
	<ObjectCreationList
		id="NY_FortWatchtower_Die_OCL">
		<CreateObject
			Options="IGNORE_ALL_OBJECTS"
			Disposition="LIKE_EXISTING RANDOM_FORCE"
			Count="1"
			MinForceMagnitude="1.0"
			MaxForceMagnitude="2.0"
			MinForcePitch="90d"
			MaxForcePitch="75d">
			<CreateObject>NY_FortWatchtower_Collapse</CreateObject>
		</CreateObject>
	</ObjectCreationList>

</AssetDeclaration>
