		<Include type="all"	source="ART:Reborn/Art/Debug/MR_RushmoreFiringBase.NEWSKIN_FILL01.w3x" />
		<Include type="all"	source="ART:Reborn/Art/Debug/MR_RushmoreFiringBase.OBBOX01.w3x" />


		<Include type="all"	source="ART:Reborn/Art/Debug/MR_RushmoreFiringBase_COL.NEW_SKIN.w3x" />
		<Include type="all"	source="ART:Reborn/Art/Debug/MR_RushmoreFiringBase_COL.OBBOX01.w3x" />


		<Include type="all"	source="ART:Reborn/Art/Debug/MR_RushmoreFiringBase_COL_CTR.w3x" />
		<Include type="all"	source="ART:Reborn/Art/Debug/MR_RushmoreFiringBase_COL_HRC.w3x" />
		<Include type="all"	source="ART:Reborn/Art/Debug/MR_RushmoreFiringBase_CTR.w3x" />
		<Include type="all"	source="ART:Reborn/Art/Debug/MR_RushmoreFiringBase_HRC.w3x" />

