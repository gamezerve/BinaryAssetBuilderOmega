		<Include type="all"	source="ART:Reborn/Art/Debug/MR_RushmoreFiringBase_NRM.xml" />
		<Include type="all"	source="ART:Reborn/Art/Debug/MR_RushmoreFiringBase_SPM.xml" />

		<!-- Base Object -->
		<Include type="instance" source="DATA:BaseObjects/BaseStructure.xml" />		
	</Includes>
	<GameObject
		id="AlliedRushmoreFiringBase"
		SelectPortrait="Portrait_FiringBase"
		ButtonImage="Button_FiringBase"
		inheritFrom="BaseStructure"
		Side="Allies"
		EditorName="AlliedRushmoreFiringBase"	
		KindOf="-CAN_BUILD_ON_WATER -CAN_BUILD_ON_DEEP_WATER +AUTO_ACQUIRABLE_BY_AI +FS_TECHNOLOGY +ACTIVATE_AFTER_UNPACK" 
		RadarPriority="STRUCTURE"
    	EditorSorting="STRUCTURE"
		PlacementViewAngle="45d"
		EnergyProduction="-50"
		ProductionQueueType="MAIN_STRUCTURE"
		BuildPlacementTypeFlag="MAIN_STRUCTURE"
		BuildTime="30"
		CommandSet="AlliedRushmoreFiringBaseCommandSet"
		TypeDescription="TYPE:AlliedRushmoreFiringBase"
		Description="DESC:AlliedRushmoreFiringBase"
		HealthBoxHeightOffset="0"
		MaxSimultaneousOfType="1">
		<DisplayName
			xai:joinAction="Replace" xmlns:xai="uri:ea.com:eala:asset:instance">NAME:RushmoreFiringBase</DisplayName>
		<ObjectResourceInfo>
			<BuildCost Account="=$ACCOUNT_ORE" Amount="2000"/>
		</ObjectResourceInfo>
		<ArmorSet
			Armor="A06_FiringBaseArmor"
			DamageFX="GenericStructureDamageFX" />
		<SkirmishAIInformation
			BaseBuildingLocation="CENTER">
      <ConstructionBaseSelectionCriteria
        ExcludedBaseTypes="NO_BUILD_RADIUS CAPTURED"
        PreferredBaseTypes="MAIN_BASE"
        SortOrder="PREFER_OLDEST" />
    </SkirmishAIInformation>
    <Draws>
			<ScriptedModelDraw
				id="ModuleTag_Draw"
				OkToChangeModelColor="true"
				ExtraPublicBone="BONE_CONTACT_POINT_01 BONE_CONTACT_POINT_02 BONE_CONTACT_POINT_03 BONE_CONTACT_POINT_04 BONE_CONTACT_POINT_05 BONE_CONTACT_POINT_06 BONE_CONTACT_POINT_07 BONE_CONTACT_POINT_08 BONE_CONTACT_POINT_09 BONE_CONTACT_POINT_10 BONE_CONTACT_POINT_11 BONE_CONTACT_POINT_12 BONE_CONTACT_POINT_13 BONE_CONTACT_POINT_14 BONE_CONTACT_POINT_15 BONE_CONTACT_POINT_16 BONE_CONTACT_POINT_17 BONE_CONTACT_POINT_18 BONE_CONTACT_POINT_19 BONE_CONTACT_POINT_20">
				<ModelConditionState
					ParseCondStateType="PARSE_DEFAULT">
					<Model
						Name="MR_RushmoreFiringBase" />
				</ModelConditionState>
			</ScriptedModelDraw>
		</Draws>
		<Behaviors>
			<AutoDepositUpdate
				id="ModuleTag_AutoDeposit"
				DepositInterval="4s"
				GiveNoXP="true"
				Flags="ACTIVE_WHEN_REPAIRING">
				<InitialCaptureBonus	Account="=$ACCOUNT_ORE" Amount="500" />
				<Deposit			Account="=$ACCOUNT_ORE" Amount="40"/>
			</AutoDepositUpdate>
			<Physics
				id="ModuleTag_Physics"/>

			<BuildingDestructionBehavior
				id="ModuleTag_BuildingDestruction">
				<DieMuxData
					DeathTypes="ALL" />
				<Item
					BonePrefix="BONE_CONTACT_POINT_"
					FX="FX_BuildingDebrisExplosion"
					CreationObject="AlliedBarracks_Debris"
					FlingVelocity="100.0"/>
			</BuildingDestructionBehavior>

			<FXListBehavior
				xai:joinAction="Replace" xmlns:xai="uri:ea.com:eala:asset:instance" id="ModuleTag_FXList">
				<DieMuxData
					DeathTypes="ALL" />
				<Event
					Index="onDeath"
					FX="FX_Civ_Explosion_Medium" />
				<Event
					Index="onDeath"
					FX="FX_Audio_RA3ExtraLargeBuildingDie" />
			</FXListBehavior>

			<CreateObjectDie
				id="ModuleTag_CreateObjectDie"
				CreationList="MR_RushmoreFiringBase_Die_OCL">
				<DieMuxData
					DeathTypes="ALL" />
			</CreateObjectDie>	
			
			<!-- civ buildings should have a CreateObjectDie to make a collapse version. -->
			<DestroyDie
				id="ModuleTag_DestroyDie">
				<DieMuxData
					DeathTypes="ALL" />
			</DestroyDie>	

			<StructureUnpackUpdate
				id="ModuleTag_StructureUnpackUpdate"
				UnpackTime="4s" />
			<xi:include
				href="DATA:Includes/GenericBuildingRepair.xml" />
			<xi:include
				href="DATA:Includes/GenericEngineerContain.xml" />
			<xi:include
				href="DATA:Includes/GenericAlliedBuildingDestruction.xml" />
			<xi:include
				href="DATA:Includes/GenericAlliedBuildingSuicide.xml" />
			<xi:include
				href="DATA:Includes/InfiltratorContainParalyze.xml" />	
			
		</Behaviors>
		
		<AI>
			<AIUpdate
				id="ModuleTag_AIUpdate"
				AutoAcquireEnemiesWhenIdle="NO"
				StateMachine="StructureAIStateMachine">
			</AIUpdate>
		</AI>
		
		<Body>
			<ActiveBody
				id="ModuleTag_Body"
				MaxHealth="5000"
				/>
		</Body>
		<Geometry
			IsSmall="false">
<Shape 
     Type= "BOX"
     MajorRadius = "75.0"
     MinorRadius = "72.0"
     Height = "110.672"
     ContactPointGeneration = "STRUCTURE" >
    <Offset
        x = "0.0"
        y = "0.0"
        z = "0.0" />
</Shape>
		</Geometry>
		<AudioArraySound>
			<AudioEntry Sound="HumanFaction_MediumBuilding_LightDamageMS" AudioType="soundOnDamaged" />
			<AudioEntry Sound="HumanFaction_MediumBuilding_HeavyDamageMS" AudioType="soundOnReallyDamaged" />
		</AudioArraySound>

		<VisionInfo
			VisionRange="150"
			ShroudClearingRange="500" />
		
	</GameObject>

	<ObjectCreationList
		id="MR_RushmoreFiringBase_Die_OCL">
		<CreateObject
			Options="IGNORE_ALL_OBJECTS"
			Disposition="LIKE_EXISTING RANDOM_FORCE"
			Count="1"
			MinForceMagnitude="1.0"
			MaxForceMagnitude="2.0"
			MinForcePitch="90d"
			MaxForcePitch="75d">
			<CreateObject>MR_RushmoreFiringBase_Collapse</CreateObject>
		</CreateObject>
	</ObjectCreationList>	
</AssetDeclaration>
