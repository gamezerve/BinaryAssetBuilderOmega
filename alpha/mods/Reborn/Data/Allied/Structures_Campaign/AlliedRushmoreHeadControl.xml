		<!-- Base Object -->
		<Include type="instance" source="DATA:BaseObjects/BaseStructure.xml" />
	</Includes>
	<GameObject
		id="AlliedRushmoreHeadControl"
		inheritFrom="BaseStructure"
		SelectPortrait="Portrait_HeadControlCenter"
		ButtonImage="Button_HeadControlCenter"
		Side="Allies"
		EditorSorting="STRUCTURE"
		BuildTime="15"
		CommandSet="AlliedRushmoreHeadControlCommandSet"
		KindOf="+FS_TECHNOLOGY -CAN_BUILD_ON_WATER -CAN_BUILD_ON_DEEP_WATER"
		RadarPriority="STRUCTURE"
		PlacementViewAngle="315d"
		EnergyProduction="-10"
		ProductionQueueType="OTHER_STRUCTURE"
		BuildPlacementTypeFlag="OTHER_STRUCTURE"
		EditorName="AlliedRushmoreHeadControl"
		Description="Desc:RushmoreHeadControlCenter"
		TypeDescription="Type:RushmoreHeadControlCenter">
		<DisplayName
			xai:joinAction="Replace" xmlns:xai="uri:ea.com:eala:asset:instance">Name:RushmoreHeadControlCenter</DisplayName>

		<ObjectResourceInfo>
			<BuildCost Account="=$ACCOUNT_ORE" Amount="1000"/>
		</ObjectResourceInfo>
		<ArmorSet
			Armor="BaseFactionStructureArmor"
			DamageFX="FactionStructureDamageFX" />
		<SkirmishAIInformation
			BaseBuildingLocation="CENTER">
      <ConstructionBaseSelectionCriteria
        ExcludedBaseTypes="NO_BUILD_RADIUS CAPTURED"
        PreferredBaseTypes="MAIN_BASE"
        SortOrder="PREFER_OLDEST" />
    </SkirmishAIInformation>
	
		<Draws>
			<ScriptedModelDraw
				id="ModuleTag_Draw"
				OkToChangeModelColor="true"
				ExtraPublicBone="BONE_CONTACT_POINT_01 BONE_CONTACT_POINT_02 BONE_CONTACT_POINT_03 BONE_CONTACT_POINT_04 BONE_CONTACT_POINT_05 BONE_CONTACT_POINT_06 BONE_CONTACT_POINT_07 BONE_CONTACT_POINT_08 BONE_CONTACT_POINT_09 BONE_CONTACT_POINT_10 BONE_CONTACT_POINT_11 BONE_CONTACT_POINT_12 BONE_CONTACT_POINT_13 BONE_CONTACT_POINT_14 BONE_CONTACT_POINT_15 BONE_CONTACT_POINT_16 BONE_CONTACT_POINT_17 BONE_CONTACT_POINT_18 BONE_CONTACT_POINT_19 BONE_CONTACT_POINT_20">
				<ModelConditionState
					ParseCondStateType="PARSE_DEFAULT">
					<Model
						Name="MR_RushmoreHeadControlCenter" />
				</ModelConditionState>
			</ScriptedModelDraw>
		</Draws>
		
		<Behaviors>		
		
			<Physics
				id="ModuleTag_Physics"/>
			<BuildingDestructionBehavior
				id="ModuleTag_BuildingDestruction">
				<DieMuxData
					DeathTypes="ALL" />
				<Item
					BonePrefix="BONE_CONTACT_POINT_"
					FX="FX_BuildingDebrisExplosion"
					CreationObject="AlliedBarracks_Debris"
					FlingVelocity="100.0"/>
			</BuildingDestructionBehavior>
			
			<FXListBehavior
				xai:joinAction="Replace" xmlns:xai="uri:ea.com:eala:asset:instance" id="ModuleTag_FXList">
				<DieMuxData
					DeathTypes="ALL" />
				<Event
					Index="onDeath"
					FX="FX_Civ_Explosion_Medium" />
			</FXListBehavior>
			

			<CreateObjectDie
				id="ModuleTag_CreateObjectDie"
				CreationList="MR_RushmoreHeadControlCenter_Die_OCL">
				<DieMuxData
					DeathTypes="ALL" />
			</CreateObjectDie>	
			
			<!-- civ buildings should have a CreateObjectDie to make a collapse version. -->
			<DestroyDie
				id="ModuleTag_DestroyDie">
				<DieMuxData
					DeathTypes="ALL" />
			</DestroyDie>	

			
			<StructureUnpackUpdate
				id="ModuleTag_StructureUnpackUpdate"
				UnpackTime="5s" />
			<xi:include
				href="DATA:Includes/GenericBuildingRepair.xml" />
			<xi:include
				href="DATA:Includes/GenericEngineerContain.xml" />
			<xi:include
				href="DATA:Includes/GenericAlliedBuildingDestruction.xml" />
			<xi:include
				href="DATA:Includes/GenericAlliedBuildingSuicide.xml" />
			<xi:include
				href="DATA:Includes/InfiltratorContainParalyze.xml" />								
		</Behaviors>

		
		<AI>
			<AIUpdate
				id="ModuleTag_AIUpdate"
				AutoAcquireEnemiesWhenIdle="NO"
				StateMachine="StructureAIStateMachine">
			</AIUpdate>
		</AI>
		
		<Body>
			<ActiveBody
				id="ModuleTag_Body"
				MaxHealth="3000.0" />
		</Body>
		
		<Geometry
			IsSmall="false">
<Shape 
     Type= "BOX"
     MajorRadius = "52.2007"
     MinorRadius = "25.542"
     Height = "70.4"
     ContactPointGeneration = "STRUCTURE" >
    <Offset
        x = "0.0"
        y = "-4.5"
        z = "0.0" />
</Shape>
		</Geometry>
		
		<AudioArraySound>
			<AudioEntry Sound="HumanFaction_MediumBuilding_LightDamageMS" AudioType="soundOnDamaged" />
			<AudioEntry Sound="HumanFaction_MediumBuilding_HeavyDamageMS" AudioType="soundOnReallyDamaged" />
		</AudioArraySound> 
		
		
		<VisionInfo
			VisionRange="150"
			ShroudClearingRange="150" />
	</GameObject>
	
	<ObjectCreationList
		id="MR_RushmoreHeadControlCenter_Die_OCL">
		<CreateObject
			Options="IGNORE_ALL_OBJECTS"
			Disposition="LIKE_EXISTING RANDOM_FORCE"
			Count="1"
			MinForceMagnitude="1.0"
			MaxForceMagnitude="2.0"
			MinForcePitch="90d"
			MaxForcePitch="75d">
			<CreateObject>MR_RushmoreHeadControlCenter_Collapse</CreateObject>
		</CreateObject>
	</ObjectCreationList>		

