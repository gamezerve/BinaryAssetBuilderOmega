<?xml version="1.0" encoding="UTF-8"?>
<AssetDeclaration xmlns="uri:ea.com:eala:asset">
  <!-- Reborn: keep the Cannes pipe mesh and lower its draw pivot to the seabed. -->
  <W3DHierarchy id="RebornCannesUnderseaPowerPipes">
    <Pivot Name="roottransform" Parent="-1">
      <Translation X="0" Y="0" Z="0"/>
      <Rotation X="0" Y="0" Z="0" W="1"/>
      <FixupMatrix M00="1" M11="1" M22="1" M33="1"/>
    </Pivot>
    <Pivot Name="pipeoffset" Parent="0">
      <Translation X="0" Y="0" Z="-70"/>
      <Rotation X="0" Y="0" Z="0" W="1"/>
      <FixupMatrix M00="1" M11="1" M22="1" M33="1"/>
    </Pivot>
  </W3DHierarchy>
  <W3DContainer id="RebornCannesUnderseaPowerPipes" Hierarchy="RebornCannesUnderseaPowerPipes">
    <SubObject BoneIndex="1" SubObjectID="POWERPIPES">
      <RenderObject><Mesh>CA_UNDERSEAPOWERPIPES</Mesh></RenderObject>
    </SubObject>
  </W3DContainer>
</AssetDeclaration>