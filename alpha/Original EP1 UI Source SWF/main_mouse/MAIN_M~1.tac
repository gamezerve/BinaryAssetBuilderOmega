    &function2 gblSMChangeScreen () (r:1='_global')
      &pushsdb 0							//'main_mouse::gblSMChangeScreen()'
      &trace
      &pushsdbgv 1							//'gSM'
      &pushsdbgm 2							//'m_intervalId'
      &pushbyte -1
      &equals
      &not
      &not
      &jnz label1      
      &pushsdbgv 1							//'gSM'
      &pushsdbgm 2							//'m_intervalId'
      &pushone
      &dcallfp 3							// clearInterval()
      &pushsdbgv 1							//'gSM'
      &pushsdb 2							//'m_intervalId'
      &pushbyte -1
      &setMember
     label1:
      &pushzero
      &pushregister 1
      &pushsdbgm 4							//'gShellScreen'
      &pushsdbgm 5							//'screen'
      &dcallmp 6							// changeScreen()
    &end // of function gblSMChangeScreen

