    &function2 gotoShellScreen (r:4='sScreenId', r:3='screenStack') (r:1='_global')
      &pushregister 1
      &pushsdbgm 34							//'SCREEN'
      &pushsdbgm 35							//'NONE'
      &pushone
      &pushregister 1
      &pushsdbgm 1							//'gSM'
      &dcallmp 36							// changeMainScreen()
      &pushzero
