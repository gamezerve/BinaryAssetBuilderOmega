      &pushregister 3
      &pushsdbgm 32							//'length'
      &lessThan
      &not
      &jnz label7      
      &pushregister 3
      &pushregister 2
      &getMember
      &pushone
      &pushregister 1
      &pushsdbgm 1							//'gSM'
      &dcallmp 36							// changeMainScreen()
      &pushregister 2
      &increment
      &setRegister r:2
      &pop
      &jmp label6      
     label7:
      &pushregister 4
      &pushone
      &pushregister 1
      &pushsdbgm 1							//'gSM'
