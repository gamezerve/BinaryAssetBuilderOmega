<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>x86</Platforms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BinaryAssetBuilder.Utility\BinaryAssetBuilder.Utility.csproj" />
    <ProjectReference Include="..\SageBinaryData\SageBinaryData.csproj" />
    <ProjectReference Include="..\BinaryAssetBuilder.XmlCompiler\BinaryAssetBuilder.XmlCompiler.csproj" />
    <!-- Reborn: keep the W3X marshaler assembly distinct from the XML marshaler's global type. -->
    <ProjectReference Include="..\BinaryAssetBuilder.W3XCompiler\BinaryAssetBuilder.W3XCompiler.csproj" Aliases="W3x" />
  </ItemGroup>

  <!-- Reborn: the successful complete alpha toolchain build refreshes one stable development SDK; failed builds never publish tools. -->
  <Target Name="RebornSyncDevelopmentSdk" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' and '$(Platform)' == 'x86' and '$(DesignTimeBuild)' != 'true' and '$(SkipAlphaSync)' != 'true'">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\Sync-Ra3Ep1DevSdk.ps1&quot; -CompilerDirectory &quot;$(TargetDir).&quot;" />
  </Target>
</Project>
