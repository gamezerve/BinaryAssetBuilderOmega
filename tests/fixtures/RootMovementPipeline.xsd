<?xml version="1.0" encoding="utf-8"?>
<!-- Reborn: bounded movement/combat source closure inherits real reference types; raw official validation remains an independent gate. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xas="uri:ea.com:eala:asset:schema" xmlns="uri:ea.com:eala:asset" targetNamespace="uri:ea.com:eala:asset" elementFormDefault="qualified">
 <xs:include schemaLocation="RootCombatPipeline.xsd"/>
 <xs:complexType name="LocomotorTemplate"><xs:complexContent><xs:extension base="BaseAssetType"/></xs:complexContent></xs:complexType>
 <xs:complexType name="LocomotorSet"><xs:sequence/>
  <xs:attribute name="id" type="Poid" xas:pipelineOnly="true"/>
  <xs:attribute name="Speed" type="SageReal"/>
  <xs:attribute name="Condition" type="LocomotorSetType"/>
  <xs:attribute name="Locomotor" type="AssetReference" xas:refType="LocomotorTemplate"/>
 </xs:complexType>
 <xs:complexType name="RootMovementProbeType"><xs:complexContent><xs:extension base="BaseAssetType"><xs:sequence>
  <xs:element name="ArmorSet" type="ArmorTemplateSet" minOccurs="0" maxOccurs="32"/>
  <xs:element name="LocomotorSet" type="LocomotorSet" minOccurs="0" maxOccurs="32"/>
  <xs:choice minOccurs="1" maxOccurs="3"><xs:element ref="BuildingDestructionBehavior"/><xs:element ref="WeaponSetUpdate"/><xs:element ref="ObjectSMCHelper"/></xs:choice>
  <xs:element name="ActiveBody" type="ActiveBodyModuleData"/>
 </xs:sequence><xs:attribute name="UnitTypeIcon" type="UnitTypeIconRef"/><xs:attribute name="UnitIntro" type="UnitIntroRef"/></xs:extension></xs:complexContent></xs:complexType>
 <xs:element name="RootMovementProbe" type="RootMovementProbeType"/>
</xs:schema>
