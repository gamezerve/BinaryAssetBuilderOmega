  <AudioEvent id="SOV_RebornSuperReactor_Sparks"
    Volume="20" VolumeShift="-5" MinRange="100" MaxRange="400"
    ShrunkenPitchModifier="2" ShrunkenVolumeModifier="85" ReverbEffectLevel="100"
