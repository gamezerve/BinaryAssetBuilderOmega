    <Sound>SBReact_ambLoopc</Sound><Sound>SBReact_ambLoopd</Sound>
    <Sound>SBReact_ambLoope</Sound><Sound>SBReact_ambLoopf</Sound>
    <Sound>SBReact_ambLoopg</Sound><Sound>SBReact_ambLooph</Sound>
    <Sound>SBReact_ambLoopi</Sound><Sound>SBReact_ambLoopj</Sound>
    <Sound>SBReact_ambLoopk</Sound><Sound>SBReact_ambLoopl</Sound>
    <Sound>SBReact_ambLoopm</Sound><Sound>SBReact_ambLoopn</Sound>
  </AudioEvent>
