<?xml version="1.0" encoding="utf-8"?>
<!-- Reborn: official EP1 primitive/asset-reference types plus a diagnostic-only root with no registered compiler or production layout. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns="uri:ea.com:eala:asset"
 xmlns:xas="uri:ea.com:eala:asset:schema" targetNamespace="uri:ea.com:eala:asset" elementFormDefault="qualified">
 <xs:include schemaLocation="../../schemas/ra3ep1/xsd/Includes/Base.xsd" />
 <xs:include schemaLocation="../../schemas/ra3ep1/xsd/Base/AssetBase.xsd" />
 <!-- Reborn: official primitive records also reference TextureRef and the shared reference declarations. -->
 <xs:include schemaLocation="../../schemas/ra3ep1/xsd/Includes/Ref.xsd" />
 <xs:simpleType name="ProbeRef" xas:isRef="true" xas:refType="DependencyProbe"><xs:restriction base="AssetReference" /></xs:simpleType>
 <xs:simpleType name="ProbeWeakRef" xas:isWeakRef="true" xas:refType="DependencyProbe"><xs:restriction base="WeakReference" /></xs:simpleType>
 <!-- Reborn: these fields exercise core identity/dependency handling, not an EA native asset type. -->
 <xs:complexType name="DependencyProbe"><xs:complexContent><xs:extension base="BaseAssetType">
  <xs:attribute name="Payload" type="xs:int" default="1" />
  <xs:attribute name="Strong" type="ProbeRef" />
  <xs:attribute name="Weak" type="ProbeWeakRef" />
  <xs:attribute name="Data" type="FileReference" />
 </xs:extension></xs:complexContent></xs:complexType>
 <xs:element name="DependencyProbe" type="DependencyProbe" />
 <xs:element name="AssetDeclaration"><xs:complexType><xs:sequence>
  <xs:element name="Includes" minOccurs="0"><xs:complexType><xs:sequence>
   <xs:element name="Include" type="Include" maxOccurs="unbounded" />
  </xs:sequence></xs:complexType></xs:element>
  <xs:element ref="DependencyProbe" minOccurs="0" maxOccurs="unbounded" />
 </xs:sequence></xs:complexType></xs:element>
</xs:schema>
