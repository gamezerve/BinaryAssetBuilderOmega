<?xml version="1.0" encoding="utf-8"?>
<!-- Reborn: source-derived rules preserve first-match order and optional catch-all conditions, including an EP1 psychic override. -->
<AssetDeclaration xmlns="uri:ea.com:eala:asset">
 <ShaderOverride id="ShaderOverride_ObjectsIronCurtain" Priority="100">
  <Rule IfOriginalShaderIs="DefaultW3D.fx" ReplaceShaderName="Null.fx" ReplaceTechniqueName="Default" />
  <Rule IfOriginalShaderIs="BuildingsGenericDamageFill.fx" ReplaceShaderName="Null.fx" ReplaceTechniqueName="Default" />
  <Rule IfOriginalShaderIs="MuzzleFlash.fx" ReplaceShaderName="MuzzleFlash.fx" ReplaceTechniqueName="Default" />
  <Rule IfOriginalShaderIs="FXLightning.fx" ReplaceShaderName="FXLightning.fx" ReplaceTechniqueName="Default" />
  <Rule IfOriginalShaderIs="Lightning.fx" ReplaceShaderName="Lightning.fx" ReplaceTechniqueName="Default" />
  <Rule ReplaceShaderName="ObjectsIronCurtain.fx" ReplaceTechniqueName="Default" />
 </ShaderOverride>
 <ShaderOverride id="ShaderOverride_BuildPlacementCursor" Priority="50">
  <Rule IfOriginalShaderIs="DefaultW3D.fx" ReplaceShaderName="Null.fx" ReplaceTechniqueName="Default" />
  <Rule IfOriginalShaderIs="BuildingsGenericDamageFill.fx" ReplaceShaderName="Null.fx" ReplaceTechniqueName="Default" />
  <Rule ReplaceShaderName="ObjectsGeneric.fx" ReplaceTechniqueName="Default" />
 </ShaderOverride>
 <ShaderOverride id="ShaderOverride_PsychicCrush" Priority="75">
  <Rule IfOriginalShaderIs="DefaultW3D.fx" ReplaceShaderName="Null.fx" ReplaceTechniqueName="Default" />
  <Rule IfOriginalShaderIs="Infantry.fx" ReplaceShaderName="InfantryCrushed.fx" ReplaceTechniqueName="Default" />
  <Rule IfOriginalShaderIs="BuildingsGenericDamageFill.fx" ReplaceShaderName="Null.fx" ReplaceTechniqueName="Default" />
  <Rule IfOriginalShaderIs="MuzzleFlash.fx" ReplaceShaderName="Null.fx" ReplaceTechniqueName="Default" />
  <Rule IfOriginalShaderIs="FXLightning.fx" ReplaceShaderName="Null.fx" ReplaceTechniqueName="Default" />
  <Rule IfOriginalShaderIs="Lightning.fx" ReplaceShaderName="Null.fx" ReplaceTechniqueName="Default" />
  <Rule IfOriginalShaderIs="FXShield.fx" ReplaceShaderName="FXShield.fx" ReplaceTechniqueName="Default" />
  <Rule IfOriginalShaderIs="DistortingObject.fx" ReplaceShaderName="DistortingObject.fx" ReplaceTechniqueName="Default" />
  <Rule IfOriginalShaderIs="ObjectsAllied.fx" ReplaceShaderName="ObjectsCrushed.fx" ReplaceTechniqueName="Default" />
  <Rule IfOriginalShaderIs="ObjectsSoviet.fx" ReplaceShaderName="ObjectsCrushed.fx" ReplaceTechniqueName="Default" />
  <Rule IfOriginalShaderIs="ObjectsJapan.fx" ReplaceShaderName="ObjectsCrushed.fx" ReplaceTechniqueName="Default" />
  <Rule IfOriginalShaderIs="BuildingsGeneric.fx" ReplaceShaderName="ObjectsCrushed.fx" ReplaceTechniqueName="Default" />
  <Rule IfOriginalShaderIs="BuildingsAllied.fx" ReplaceShaderName="ObjectsCrushed.fx" ReplaceTechniqueName="Default" />
  <Rule IfOriginalShaderIs="BuildingsSoviet.fx" ReplaceShaderName="ObjectsCrushed.fx" ReplaceTechniqueName="Default" />
  <Rule IfOriginalShaderIs="BuildingsJapan.fx" ReplaceShaderName="ObjectsCrushed.fx" ReplaceTechniqueName="Default" />
  <Rule ReplaceShaderName="ObjectsCrushed.fx" ReplaceTechniqueName="Default" />
 </ShaderOverride>
 <ShaderOverride id="ShaderOverride_ObjectsWithoutXrayEffect" Priority="85">
  <Rule IfOriginalShaderIs="ObjectsGenericLightmapXray.fx" ReplaceShaderName="ObjectsGenericLightmap.fx" ReplaceTechniqueName="Default" />
 </ShaderOverride>
</AssetDeclaration>
