	"Capture the Vacuum Imploder Superweapon"
End

OBJECTIVE:S08_DEFEAT_ALLIED_FORCES
	"Stop the Allied Counter-Offensive"
End

OBJECTIVE:S08_DEFEAT_THE_PREMIERE
	"Destroy the Premier's Volcano Fortress"
End

OBJECTIVE:S08_DESTROY_SUPERWEAPON
	"Destroy the Vacuum Imploder Before It Fires"
End

