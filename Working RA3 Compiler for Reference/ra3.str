	"*[88.5:1.1]If what works?"
End

SUBTITLE:SFS00_18
	"*[90.1:2.6]My... time machine."
End

SUBTITLE:SFS00_19
	"*[96.5:2.2]Prepare these coordinates."
End

SUBTITLE:SFS00_20
	"*[98.8:2.4]No... Please... Please..."
End

SUBTITLE:SFS00_21
	"*[101.2:0.9]Now!"
End

SUBTITLE:SFS00_22
	"*[103.9:2.5]Sir... No! No..."
